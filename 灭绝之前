                    if root and root:IsA("BasePart") then
                        table.insert(items, {pos=root.Position, id=tostring(corpseId), name=data.Name or "Corpse", isCorpse=true})
                    end
                end
            end
            if myPos then table.sort(items, function(a,b) return (a.pos - myPos).Magnitude < (b.pos - myPos).Magnitude end) end
            return items
        end

        local function createBiteBuffer(foodId)
            local bufLib = buffer and buffer.create and buffer or nil
            if not bufLib then pcall(function() bufLib = require(ReplicatedStorage.Packages.buffer) end) end
            if bufLib then local buf = bufLib.create(5); bufLib.writeu32(buf,0,tonumber(foodId)); bufLib.writeu8(buf,4,1); return buf end
            return nil
        end

        local function startEating()
            active = true; applyFallImmunity()
            loopThread = task.spawn(function()
                while active do
                    local rep = nil; pcall(function() rep = charController:GetCharacterReplica(lPlayer) end)
                    if not rep then task.wait(1); continue end
                    local food = rep.Data.Stats.Food; local maxFood = rep.Data.MaxStats.Food
                    if food >= maxFood then setConsumeActive(false); task.wait(2); continue end
                    local allFood = getAllFoodItems()
                    if #allFood == 0 then setConsumeActive(false); task.wait(3); continue end
                    local target = allFood[1]; local id = target.id; local isCorpse = target.isCorpse
                    if isCorpse then
                        setConsumeActive(true)
                        local buf = createBiteBuffer(id)
                        if buf then
                            local consRep = ConsumptionController.Replica
                            if consRep then pcall(function() consRep:FireServer("Bite", buf) end) end
                        end
                        setConsumeActive(false)
                        task.wait(1.0)
                    else
                        setConsumeActive(true)
                        local buf = createBiteBuffer(id)
                        if buf then
                            local consRep = ConsumptionController.Replica
                            if consRep then pcall(function() consRep:FireServer("Bite", buf) end) end
                        end
                        setConsumeActive(false)
                        task.wait(0.5)
                    end
                end
                setConsumeActive(false)
            end)
        end

        local function stopEating()
            active = false; if loopThread then task.cancel(loopThread); loopThread = nil end
            setConsumeActive(false)
        end

        function enableVacuumFood() if not active then startEating() end end
        function disableVacuumFood() if active then stopEating() end end

        vacuumFoodGroupbox:AddToggle("vacuumFoodToggled", {Text = "Vacuum Food"})
        addKeybindForToggle(vacuumFoodGroupbox, "vacuumFoodToggled")
        Toggles.vacuumFoodToggled:OnChanged(function(enabled) if enabled then enableVacuumFood() else disableVacuumFood() end end)
    end
end

