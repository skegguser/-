    label.TextColor3 = Color3.new(1,1,1); label.Font = Enum.Font.GothamBold; label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left; label.TextYAlignment = Enum.TextYAlignment.Top; label.TextWrapped = true; label.Parent = frame
    statsFrame = frame; statsLabel = label; statsGUIOpen = true
end

local function updateStatsUI()
    if not statsGUIOpen or not statsLabel then return end
    if not CharacterState or not CharacterState.Replica then return end
    local replica = CharacterState.Replica
    local growth = replica.Data.Growth
    if not growth then return end
    local stage = growth.Stage or "?"
    local delta = growth.Delta or 0
    local mass = growth.Mass or 0
    local multiplier = replica.Data.Multipliers and replica.Data.Multipliers.MassGain or 1

    if lastMass == nil then lastMass = mass end
    if mass ~= lastMass then
        lastTickTime = tick()
        lastMass = mass
    end

    local tickText = ""
    if lastTickTime then
        local elapsed = tick() - lastTickTime
        local remaining = math.max(0, TICK_DURATION - elapsed)
        tickText = string.format("\nNext Growth Tick: %.1fs", remaining)
    else
        tickText = "\nNext Growth Tick: 0.0s"
    end

    statsLabel.Text = string.format("Stage: %s\nProgress: %.1f%%\nMass: %.1f\nMultiplier: %.2fx%s",
        stage, delta*100, mass, multiplier, tickText)
    statsFrame.Size = UDim2.new(0, 200, 0, 100)
end

statsGroupbox:AddToggle("showStatsToggled", {Text = "Show Stats UI"})
Toggles.showStatsToggled:OnChanged(function(enabled)
    if enabled then createStatsUI() else
        if statsFrame then statsFrame:Destroy(); statsFrame=nil; statsLabel=nil end
        statsGUIOpen=false
        lastMass = nil; lastTickTime = nil
    end
end)

