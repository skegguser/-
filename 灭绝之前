        Toggles.fossilFarmToggled:OnChanged(function(enabled)
            if enabled then enableFossilFarm() else disableFossilFarm() end
        end)
    end

    -- VACUUM FOOD (Premium, Misc tab)
    do
        local active = false; local loopThread = nil
        local function getAllFoodItems()
            local items = {}
            local char = lPlayer.Character; local myPos = char and (getPhysicsBody(char) and getPhysicsBody(char).Position)
            local biomes = Workspace:FindFirstChild("Biomes"); if not biomes then return items end
            for _, biome in ipairs(biomes:GetChildren()) do
                if biome:IsA("Folder") or biome:IsA("Model") then
                    for _, model in ipairs(biome:GetDescendants()) do
                        if model:IsA("Model") then
                            local id = model:GetAttribute("ID")
                            if id then
                                local pos = model.PrimaryPart and model.PrimaryPart.Position
                                if not pos then for _, p in ipairs(model:GetChildren()) do if p:IsA("BasePart") then pos = p.Position; break end end end
                                if pos then table.insert(items, {pos=pos, id=tostring(id), name=model.Name, isCorpse=false}) end
                            end
                        end
                    end
                end
            end
            if ConsumptionController.CorpseData then
                for corpseId, data in pairs(ConsumptionController.CorpseData) do
