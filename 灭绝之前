local keybindUIGui = nil
local function createKeybindUI()
    if keybindUIGui then keybindUIGui:Destroy() end
    local gui = Instance.new("ScreenGui")
    gui.Name = "KeybindUI"
    gui.Parent = lPlayer:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.fromRGB(20,20,20)
    frame.BackgroundTransparency = 0.3
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui
    frame.Position = UDim2.new(0.01, 0, 0.05, 0)

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0,4)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = frame

    local entryHeight = 20
    local entries = {}

    local function resizeFrame()
        local count = 0
        for _ in pairs(entries) do count = count + 1 end
        if count == 0 then count = 1 end
        frame.Size = UDim2.new(0, 180, 0, count * (entryHeight + 4))
    end

    local function removeEntry(toggleName)
        local entry = entries[toggleName]
        if entry then
            if entry.container then entry.container:Destroy() end
            entries[toggleName] = nil
            resizeFrame()
        end
    end

    local function addEntry(toggleName)
        if entries[toggleName] then return end
        local keyOpt = Options["key"..toggleName]
        if not keyOpt or keyOpt.Value == "None" then return end

        local container = Instance.new("Frame")
        container.Size = UDim2.new(1,0,0,entryHeight)
        container.BackgroundTransparency = 1
        container.LayoutOrder = #listLayout:GetChildren() + 1
        container.Parent = frame

        local keyLabel = Instance.new("TextLabel")
        keyLabel.Size = UDim2.new(0,40,1,0)
        keyLabel.Position = UDim2.new(0,4,0,0)
        keyLabel.BackgroundTransparency = 1
        keyLabel.Font = Enum.Font.GothamBold
        keyLabel.TextSize = 13
        keyLabel.Text = keyOpt.Value
        keyLabel.Parent = container

        local toggleLabel = Instance.new("TextLabel")
        toggleLabel.Size = UDim2.new(1,-48,1,0)
        toggleLabel.Position = UDim2.new(0,48,0,0)
        toggleLabel.BackgroundTransparency = 1
        toggleLabel.Font = Enum.Font.Gotham
        toggleLabel.TextSize = 13
        toggleLabel.TextXAlignment = Enum.TextXAlignment.Left
        toggleLabel.Text = toggleName
        toggleLabel.Parent = container

        entries[toggleName] = {container = container, keyLabel = keyLabel, toggleLabel = toggleLabel}
        resizeFrame()

        local enabled = Toggles[toggleName] and Toggles[toggleName].Value or false
        local col = enabled and Color3.fromRGB(0,255,0) or Color3.fromRGB(150,150,150)
        keyLabel.TextColor3 = col
        toggleLabel.TextColor3 = col

        keyOpt:OnChanged(function()
            local val = keyOpt.Value
            if val == "None" then
                removeEntry(toggleName)
            else
                if entries[toggleName] then
                    entries[toggleName].keyLabel.Text = val
                    local enabled = Toggles[toggleName] and Toggles[toggleName].Value or false
                    local col = enabled and Color3.fromRGB(0,255,0) or Color3.fromRGB(150,150,150)
                    entries[toggleName].keyLabel.TextColor3 = col
                    entries[toggleName].toggleLabel.TextColor3 = col
                else
                    addEntry(toggleName)
                end
            end
        end)
        Toggles[toggleName]:OnChanged(function()
            if entries[toggleName] then
                local enabled = Toggles[toggleName].Value
                local col = enabled and Color3.fromRGB(0,255,0) or Color3.fromRGB(150,150,150)
                entries[toggleName].keyLabel.TextColor3 = col
                entries[toggleName].toggleLabel.TextColor3 = col
            end
        end)
    end

    for toggleName, _ in pairs(Toggles) do
        if Options["key"..toggleName] then
            local keyOpt = Options["key"..toggleName]
            if keyOpt.Value ~= "None" then
                addEntry(toggleName)
            end
            keyOpt:OnChanged(function()
                if keyOpt.Value ~= "None" then
                    if not entries[toggleName] then addEntry(toggleName) end
                else
                    if entries[toggleName] then removeEntry(toggleName) end
                end
            end)
        end
    end

    keybindUIGui = gui
end

local function showKeybindUI()
    if not keybindUIGui then createKeybindUI() end
    keybindUIGui.Enabled = true
end
local function hideKeybindUI()
    if keybindUIGui then keybindUIGui.Enabled = false end
end

Toggles.keybindUIToggled:OnChanged(function(enabled)
    if enabled then showKeybindUI() else hideKeybindUI() end
end)
