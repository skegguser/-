            pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, nil) end)
            if prompt then pcall(function() prompt:InputHoldEnd() end) end
            if isCollectibleGone(cd) then Library:Notify("Collected " .. cd.FossilType) end
