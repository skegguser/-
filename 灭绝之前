saveActive = false; isInSafety = false; safetyHeartbeat = nil; safetyOriginalPos = nil; healthConnection = nil; maxHealth = nil
function findRoot()
    local char = lPlayer.Character; if not char then return nil end
    local mm = char:FindFirstChild("MeshModel"); if mm then local r = mm:FindFirstChild("RootPart"); if r and r:IsA("BasePart") then return r end end
    return char:FindFirstChild("RootPart", true) or char.PrimaryPart
end

function goToSafety()
    if isInSafety then return end
    local r = findRoot()
    if not r or not r.Parent then return end
    isInSafety = true
    if not noFallEnabled then enableNoFall() end
    if safetyHeartbeat then safetyHeartbeat:Disconnect(); safetyHeartbeat = nil end

    -- Save original position so we can return here on release
    safetyOriginalPos = r.Position

    -- High altitude outside any barrier range (workspace.Biomes.Barrier parts are at ground level, 5000 is safe)
    local safeY = 5000
    local targetPos = Vector3.new(r.Position.X, safeY, r.Position.Z)
    local upsideDownRotation = CFrame.Angles(math.pi, 0, 0)  -- upside down

    -- Teleport and lock position every frame (no anchoring, server sees this)
    r.Anchored = false
    r.CFrame = CFrame.new(targetPos) * upsideDownRotation
    r.Velocity = Vector3.zero
    r.RotVelocity = Vector3.zero
    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    safetyHeartbeat = RunService.Heartbeat:Connect(function()
        if not isInSafety then return end
        local cr = findRoot()
        if cr and cr.Parent then
            cr.Anchored = false
            cr.CFrame = CFrame.new(cr.Position.X, safeY, cr.Position.Z) * upsideDownRotation
            cr.Velocity = Vector3.zero
            cr.RotVelocity = Vector3.zero
            cr.AssemblyLinearVelocity = Vector3.zero
            cr.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

function releaseFromSafety()
    if not isInSafety then return end
    isInSafety = false
    if safetyHeartbeat then safetyHeartbeat:Disconnect(); safetyHeartbeat = nil end
    local r = findRoot()
    if r and r:IsA("BasePart") then
        -- Teleport back to original ground position
        if safetyOriginalPos then
            r.CFrame = CFrame.new(safetyOriginalPos)
            r.Velocity = Vector3.zero
            r.RotVelocity = Vector3.zero
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
            safetyOriginalPos = nil
        end
        r.Anchored = false
    end
    if not Toggles.noFallToggled.Value then disableNoFall() end
end

function setupHealthWatcher(char)
    if not char then return end
    if healthConnection then healthConnection:Disconnect(); healthConnection = nil end
    maxHealth = nil
    healthConnection = char:GetAttributeChangedSignal("Health"):Connect(function()
        if not saveActive or isInSafety then return end
        local h = char:GetAttribute("Health")
        if not h or h <= 0 then return end
        if not maxHealth then
            maxHealth = char:GetAttribute("MaxHealth") or char:GetAttribute("maxHealth") or h
        end
        if maxHealth and (h / maxHealth) * 100 <= Options.saveDinoHealth.Value then
            goToSafety()
        end
    end)
end

