            setConsumeActive(false)
            local prompt = cd.Folder and cd.Folder:FindFirstChild("ProximityPrompt", true)
            if not prompt then prompt = cd.Object and cd.Object:FindFirstChild("ProximityPrompt", true) end
            local holdTime = getHoldTime(cd.Part)
            local waited = 0
            while waited < holdTime + 15 and not isCollectibleGone(cd) and fossilFarmActive do
                if prompt then pcall(function() prompt:InputHoldBegin() end) end
                pcall(function() VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, nil) end)
                task.wait(0.3)
