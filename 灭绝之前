local function fullCharacterReset()
    local char = lPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local bv = part:FindFirstChildOfClass("BodyVelocity")
            if bv then bv:Destroy() end
            local bp = part:FindFirstChildOfClass("BodyPosition")
            if bp then bp:Destroy() end
            local bg = part:FindFirstChildOfClass("BodyGyro")
            if bg then bg:Destroy() end
            part.CanCollide = true
            part.Anchored = false
        end
    end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("RootPart") or char.PrimaryPart
    if root then
        root.Anchored = false
        root.Velocity = Vector3.zero
        root.RotVelocity = Vector3.zero
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum:ChangeState(Enum.HumanoidStateType.Running)
        hum.Jump = false
    end
end

