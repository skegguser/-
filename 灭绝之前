    silentAimGroupbox:AddDropdown("silentAimPart", {Text = "Target Part", Values = {"Head", "Neck", "Tail"}, Default = "Head", AllowNull = false, Multi = false})
    silentAimGroupbox:AddSlider("silentAimExpansionSize", {Text = "Expansion Size", Min = 5, Max = 30, Default = 10, Rounding = 0})
    silentAimGroupbox:AddSlider("silentAimTransparency", {Text = "Outline Transparency", Min = 0, Max = 1, Default = 0.5, Rounding = 2})
    silentAimGroupbox:AddSlider("silentAimDistance", {Text = "Max Distance", Min = 50, Max = 300, Default = 200, Rounding = 0})

    local enemySilentAimData = {}
    local targetPartNames = {
        Head = {"Head", "head", "Skull", "skull"},
        Neck = {"Neck", "Neck.001", "Neck_1", "Neck1", "neck"},
        Tail = {"Tail.001", "Tail.002", "Tail.003", "Tail.004", "Tail.005", "Tail.006", "Tail_1", "Tail1"}
    }

    local function getTargetPart(hitbox, partChoice)
        local names = targetPartNames[partChoice] or {"Head"}
        for _, name in ipairs(names) do
            local part = hitbox:FindFirstChild(name)
            if part and part:IsA("BasePart") then return part end
        end
        return nil
    end

    local function restoreEnemyHitboxes(plr)
        local data = enemySilentAimData[plr]
        if not data then return end
        for part, origSize in pairs(data.origSizes) do
            if part and part.Parent then
                part.Size = origSize
                part.Name = data.origNames[part] or part.Name
                part.CanTouch = true; part.CanQuery = true; part.CanCollide = false; part.Massless = true
            end
        end
        if data.adornment then data.adornment:Destroy() end
        enemySilentAimData[plr] = nil
    end

    local function updateSilentAim()
        if not (Toggles.silentAimToggled and Toggles.silentAimToggled.Value) then
            for plr in pairs(enemySilentAimData) do restoreEnemyHitboxes(plr) end
            return
        end
        local expansionSize = Options.silentAimExpansionSize.Value
        local transparency = Options.silentAimTransparency.Value
        local partChoice = Options.silentAimPart.Value
        local maxDist = Options.silentAimDistance.Value
        local myChar = lPlayer.Character
        local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)
        local myPos = myRoot and myRoot.Position
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == lPlayer then continue end
            if isTeamCheckEnabled() and isSameSpecies(plr) then restoreEnemyHitboxes(plr); continue end
            local char = plr.Character
            if not char then restoreEnemyHitboxes(plr); continue end
            local theirRoot = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            if myPos and theirRoot then
                local dist = (myPos - theirRoot.Position).Magnitude
                if dist > maxDist then restoreEnemyHitboxes(plr); continue end
            else restoreEnemyHitboxes(plr); continue end
            local hb = char:FindFirstChild("Hitbox")
            if not hb then restoreEnemyHitboxes(plr); continue end
            local targetPart = getTargetPart(hb, partChoice)
            if not targetPart then restoreEnemyHitboxes(plr); continue end
            local data = enemySilentAimData[plr]
            if not data then data = { origSizes = {}, origNames = {} }; enemySilentAimData[plr] = data end
            for _, part in ipairs(hb:GetChildren()) do
                if part:IsA("BasePart") then
                    if not data.origSizes[part] then data.origSizes[part] = part.Size; data.origNames[part] = part.Name end
                end
            end
            for _, part in ipairs(hb:GetChildren()) do
                if part:IsA("BasePart") and part ~= targetPart then
                    part.Size = Vector3.new(0.001, 0.001, 0.001)
                    part.CanTouch = false; part.CanQuery = false; part.CanCollide = false; part.Massless = true
                end
            end
            if targetPart.Name ~= partChoice or targetPart.Size ~= Vector3.new(expansionSize, expansionSize, expansionSize) then
                targetPart.Name = partChoice
                targetPart.Size = Vector3.new(expansionSize, expansionSize, expansionSize)
            end
            targetPart.CanTouch = true; targetPart.CanQuery = true; targetPart.CanCollide = false; targetPart.Massless = true; targetPart.Transparency = 1
            local adornment = data.adornment
            if not adornment or not adornment.Parent then
                if adornment then adornment:Destroy() end
                adornment = Instance.new("BoxHandleAdornment")
                adornment.Adornee = targetPart; adornment.AlwaysOnTop = false; adornment.ZIndex = 10
                adornment.Color3 = Color3.fromRGB(0, 255, 255); adornment.Parent = targetPart; data.adornment = adornment
            end
            adornment.Size = Vector3.new(expansionSize, expansionSize, expansionSize)
            adornment.Transparency = transparency; adornment.Visible = true
        end
    end
    RunService.Heartbeat:Connect(updateSilentAim)
end

