            end
            fossilSpectateTarget = nil
            camera.CameraType = oldCamType or Enum.CameraType.Custom
            camera.CameraSubject = oldCamSubject or (lPlayer.Character and lPlayer.Character:FindFirstChildOfClass("Humanoid"))
        end

        local function getAllCollectibles()
            local all = {}
            local sf = Workspace:FindFirstChild("SpawnedFossils")
            local selected = Options.fossilTypesDropdown:GetActiveValues()
            local function isSelected(t) for _, v in ipairs(selected) do if v == t then return true end end return false end
            if sf then
                for _, folder in ipairs(sf:GetChildren()) do
                    if folder:IsA("Folder") or folder:IsA("Model") then
                        local part, ftype = nil, nil
                        for _, obj in ipairs(folder:GetDescendants()) do
                            if obj:IsA("BasePart") then
                                local n = obj.Name:lower()
                                if n == "fossils" and isSelected("Small") then part, ftype = obj, "Small" break
                                elseif n == "fossilm" and isSelected("Medium") then part, ftype = obj, "Medium" break
                                elseif n == "fossill" and isSelected("Large") then part, ftype = obj, "Large" break
                                elseif (n == "sphere" or n == "opal") and isSelected("Opal") then part, ftype = obj, "Opal" break
                                elseif isSelected("Skull") then
                                    for _, sName in ipairs(skullNames) do if n == sName then part, ftype = obj, "Skull" break end end
                                end
                                if part then break end
                            end
                        end
                        if part and ftype then table.insert(all, {Part = part, Folder = folder, Type = "Fossil", FossilType = ftype}) end
                    end
                end
            end
            if isSelected("Gemstone") then
                local ci = Workspace:FindFirstChild("CharacterIgnore")
                if ci then
                    local gs = ci:FindFirstChild("GemstoneSpawns")
                    if gs then
                        local spawned = gs:FindFirstChild("Spawned")
                        if spawned then
                            for _, gem in ipairs(spawned:GetChildren()) do
                                local nameLower = gem.Name:lower()
                                local isGem = false
                                for _, gName in ipairs(gemstoneNames) do if nameLower:find(gName) then isGem = true; break end end
                                if isGem then
                                    local p = gem:FindFirstChild("MineralBase") or gem:FindFirstChildWhichIsA("BasePart") or gem
                                    table.insert(all, {Part = p, Object = gem, Type = "Gemstone", FossilType = "Gemstone"})
                                end
                            end
                        end
                    end
                end
            end
            return all
        end

        local function getClosestCollectible()
            local body = getPhysicsBody(lPlayer.Character); if not body then return nil end
            local all = getAllCollectibles(); if #all == 0 then return nil end
            table.sort(all, function(a,b) return (a.Part.Position - body.Position).Magnitude < (b.Part.Position - body.Position).Magnitude end)
            return all[1]
        end

        local function isCollectibleGone(cd)
            if not cd then return true end
            if cd.Type == "Fossil" then
                if not cd.Folder or not cd.Folder.Parent then return true end
                for _, c in ipairs(cd.Folder:GetDescendants()) do if c:IsA("BasePart") then return false end end
                return true
            elseif cd.Type == "Gemstone" then return not cd.Object or not cd.Object.Parent end
            return true
        end

        local function getHoldTime(part)
            if part.Parent and part.Parent.Name:lower():find("iolite") then return 20 end
            local n = part.Name:lower()
            if n:find("fossils") then return 3 elseif n:find("fossilm") then return 5 elseif n:find("fossill") then return 10 else return 10 end
        end

        local function flyToTarget(targetPos, speed)
            local body = getPhysicsBody(lPlayer.Character)
            if not body then return end
            local root = body
            local gyro = root:FindFirstChildOfClass("BodyGyro") or Instance.new("BodyGyro")
            gyro.MaxTorque = Vector3.new(400000, 400000, 400000)
            gyro.P = 10000
            gyro.D = 1000
            gyro.CFrame = CFrame.new(root.Position, targetPos) * CFrame.Angles(math.pi, 0, 0)
            gyro.Parent = root
            local bv = root:FindFirstChildOfClass("BodyVelocity") or Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            bv.Velocity = (targetPos - root.Position).Unit * speed
            bv.Parent = root
            local startTime = tick()
            while (targetPos - root.Position).Magnitude > 5 and fossilFarmActive do
                bv.Velocity = (targetPos - root.Position).Unit * speed
                gyro.CFrame = CFrame.new(root.Position, targetPos) * CFrame.Angles(math.pi, 0, 0)
                local elapsed = tick() - startTime
                flyTimerLabel:SetText(string.format("Flying: %.1fs", elapsed))
                task.wait(0.05)
            end
            flyTimerLabel:SetText("")
            gyro:Destroy()
            bv:Destroy()
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
            root.Anchored = true
            task.wait(0.2)
            root.Anchored = false
        end

        local function collectFossil(cd)
            if not cd or not cd.Part or not cd.Part.Parent then return false end
            local targetPos = cd.Part.Position
            local speed = Options.fossilFlySpeed and Options.fossilFlySpeed.Value or 300
            flyToTarget(targetPos, speed)
            local body = getPhysicsBody(lPlayer.Character)
            if body then
                body.Anchored = true
                body.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.pi, 0, 0)
                body.Velocity = Vector3.zero
                task.wait(0.2)
