local dayTimeToggles = {"dayTimeToggled", "sunsetTimeToggled", "nightTimeToggled", "sunriseTimeToggled"}
local currentDayMode = nil
local dayLockLoop = nil
local blackScreenGui = nil

local timeConfig = {
    ClearDay     = { ClockTime = 14, Period = "Day" },
    ClearSunset  = { ClockTime = 18, Period = "Sunset" },
    ClearNight   = { ClockTime = 0,  Period = "Night" },
    ClearSunrise = { ClockTime = 6,  Period = "Sunrise" },
}

local savedAttrs = {}

local function findBlackScreenGui()
    if not lPlayer then return nil end
    local pg = lPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    return pg:FindFirstChild("BlackScreenGui")
end

local function setDayAttrs(mode)
    local cfg = timeConfig[mode]
    if not cfg then return end
    pcall(function() Lighting:SetAttribute("RealClockTime", cfg.ClockTime) end)
    pcall(function() Lighting:SetAttribute("TransitionPeriod", "Clear_" .. cfg.Period) end)
    pcall(function() Lighting:SetAttribute("CurrentWeather", "Clear") end)
    if WeatherController and WeatherController.SkipToCurrent then
        pcall(function() WeatherController:SkipToCurrent() end)
    end
end

local function restoreDayAttrs()
    if savedAttrs.RealClockTime ~= nil then
        pcall(function() Lighting:SetAttribute("RealClockTime", savedAttrs.RealClockTime) end)
    end
    if savedAttrs.TransitionPeriod ~= nil then
        pcall(function() Lighting:SetAttribute("TransitionPeriod", savedAttrs.TransitionPeriod) end)
    end
    if savedAttrs.CurrentWeather ~= nil then
        pcall(function() Lighting:SetAttribute("CurrentWeather", savedAttrs.CurrentWeather) end)
    end
    if WeatherController and WeatherController.SkipToCurrent then
        pcall(function() WeatherController:SkipToCurrent() end)
    end
end

local function startDayLock(mode)
    if dayLockLoop then dayLockLoop:Disconnect() end
    if not savedAttrs.RealClockTime then
        savedAttrs.RealClockTime = Lighting:GetAttribute("RealClockTime")
        savedAttrs.TransitionPeriod = Lighting:GetAttribute("TransitionPeriod")
        savedAttrs.CurrentWeather = Lighting:GetAttribute("CurrentWeather")
    end
    currentDayMode = mode
    setDayAttrs(mode)
    blackScreenGui = findBlackScreenGui()
    if blackScreenGui then
        blackScreenGui.Enabled = false
    end
    dayLockLoop = RunService.Heartbeat:Connect(function()
        if currentDayMode == mode then
            setDayAttrs(mode)
        else
            if dayLockLoop then dayLockLoop:Disconnect(); dayLockLoop = nil end
        end
    end)
end

local function stopDayLock()
    currentDayMode = nil
    if dayLockLoop then dayLockLoop:Disconnect(); dayLockLoop = nil end
    restoreDayAttrs()
    savedAttrs = {}
    if blackScreenGui then
        blackScreenGui.Enabled = true
        blackScreenGui = nil
    end
end

local function disableOtherDayToggles(except)
    for _, toggleName in ipairs(dayTimeToggles) do
        if toggleName ~= except and Toggles[toggleName].Value then
            Toggles[toggleName]:SetValue(false)
        end
