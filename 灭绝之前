    -- Fossil farm implementation
    do
        local fossilFarmActive = false; local fossilFarmLoop = nil
        local gemstoneNames = {"iolite", "diamond", "ruby", "jade", "melanite", "sapphire", "celestine"}
        local skullNames = {"rex skull", "triceratops skull"}

        local flyTimerLabel = fossilFarmGroupbox:AddLabel("")
        local fossilSpectateTarget = nil
        local spectateConn = nil
        local oldCamType, oldCamSubject

        local function startSpectate()
            if spectateConn then return end
            oldCamType = camera.CameraType
            oldCamSubject = camera.CameraSubject
            camera.CameraType = Enum.CameraType.Scriptable
            spectateConn = RunService.RenderStepped:Connect(function()
                if fossilSpectateTarget then
                    local camPos = fossilSpectateTarget + Vector3.new(0, 10, 20)
