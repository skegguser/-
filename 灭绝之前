        fossilFarmGroupbox:AddToggle("fossilFarmToggled", {Text = "Start Farming"})
        addKeybindForToggle(fossilFarmGroupbox, "fossilFarmToggled")
        fossilFarmGroupbox:AddDropdown("fossilTypesDropdown", {
            Text = "Fossil Types",
